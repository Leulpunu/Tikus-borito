# Copy this file to .env.local and replace the placeholders from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never prefix this value with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Optional and server/operations-only. Used by `npm run backup:database`.
SUPABASE_DB_URL=postgresql://postgres.project-ref:password@host:5432/postgres

# Used only by `npm run setup:manager`.
BOOTSTRAP_MANAGER_EMAIL=manager@example.com
BOOTSTRAP_MANAGER_PASSWORD=replace-with-a-strong-password
